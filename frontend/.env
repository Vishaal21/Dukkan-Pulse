# API base URL for the FastAPI backend.
#
# Leave empty in development: requests use relative paths (/api/...)
# and Vite's dev proxy forwards them to the backend (see vite.config.js).
#
# In production, set this to your deployed backend origin, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
# (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000
