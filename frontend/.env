# API base URL for the FastAPI backend. No secret here, so it is committed.
#
# Leave empty for BOTH cases:
#  - local dev: requests use relative paths (/api/...) and Vite's dev proxy
#    forwards them to the backend (see vite.config.js).
#  - single deploy: the backend also serves this app, so /api/... is same-origin.
#
# Only set this when the frontend is deployed SEPARATELY from the backend, e.g.:
#   VITE_API_BASE_URL=https://your-backend.onrender.com
# (no trailing slash)
VITE_API_BASE_URL=
